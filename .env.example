# ============================================================
# KrishiMitra — Voice-First Multilingual Agricultural Assistant
# Copy to .env and configure optional external credentials.
# ============================================================

# ── Security & Privacy ───────────────────────────────────────
ADMIN_API_KEY=krishimitra-admin-2026
AUDIO_RETENTION_HOURS=24

# ── LLM Inference (Ollama Local / OpenAI-Compatible) ─────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_CONNECT_TIMEOUT=2.0
LLM_READ_TIMEOUT=45.0

# ── Speech-to-Text (Whisper) ─────────────────────────────────
WHISPER_MODEL=base
STT_CONFIDENCE_THRESHOLD=0.35

# ── Embeddings & Retrieval ───────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MAX_CHUNKS=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CONFIDENCE_THRESHOLD=0.28

# ── Text-to-Speech ───────────────────────────────────────────
# Options: gtts | bhashini
TTS_PROVIDER=gtts
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# ── WhatsApp Business Cloud API (optional) ───────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=agri_assistant_webhook_verify_token

# ── Live Agricultural Data APIs ──────────────────────────────
# Open-Meteo works automatically with no key; OpenWeatherMap is optional
OPENWEATHER_API_KEY=
# Register free at https://data.gov.in for live Agmarknet mandi prices
AGMARKNET_API_KEY=
WEATHER_CACHE_TTL_SECONDS=900
MANDI_CACHE_TTL_SECONDS=1800

# ── Server ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501
